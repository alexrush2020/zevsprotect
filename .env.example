DATABASE_URL=postgres://zevs:zevs@127.0.0.1:5442/zevs
PAYLOAD_SECRET=change-me
NEXT_PUBLIC_SERVER_URL=http://localhost:43127

# Почта (SMTP). Без SMTP_HOST письма только печатаются в консоль.
# Локально — mailpit из docker-compose.yml: SMTP_HOST=localhost, SMTP_PORT=43125, письма в http://localhost:43126
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@zevsprotect.ru

# Куда слать уведомления о заявках с форм (иначе — email из «Настройки → Контакты»)
LEADS_EMAIL=

# Битрикс24: входящий вебхук https://<портал>/rest/<user>/<секрет>/ (пусто — интеграция выключена, отправки падают с syncError)
B24_WEBHOOK_URL=
# ID с портала заказчика (пусто — поле не передаётся, см. вопросы в lib/b24/config.ts)
B24_DEAL_CATEGORY_ID=
B24_DEAL_STAGE_ID=
B24_ASSIGNED_BY_ID=
B24_SOURCE_ID=WEB
B24_REQUISITE_PRESET_ID=
# Токен исходящего вебхука Б24 (application_token) для POST /api/b24/webhook; пусто — вебхук отвечает 503
B24_WEBHOOK_TOKEN=
# 1 — сделка в Б24 и для гостевого заказа (BIZ-7 не решён; по умолчанию только для зарегистрированных)
B24_GUEST_DEALS=

# каталог загрузок Media (по умолчанию ./media); на проде — путь к тому
MEDIA_DIR=

# 1С «Обмен с сайтом» (CommerceML, /api/1c-exchange). Логин/пароль пусты — обмен закрыт (503)
ONEC_EXCHANGE_USER=
ONEC_EXCHANGE_PASSWORD=
# каталог файлов обмена; на проде обязателен, вне /tmp (по умолчанию os.tmpdir()/zevs-1c)
ONEC_EXCHANGE_DIR=
# размер одной части файла (file_limit для 1С), байт; по умолчанию 10 МБ
ONEC_EXCHANGE_FILE_LIMIT=
# потолок XML-файла пакета (сумма частей), байт; по умолчанию 50 МБ. Картинки — до 200 МБ
ONEC_EXCHANGE_XML_LIMIT=
# Ид типа цены 1С для сайта (BIZ-8); пусто — берётся первая цена предложения, это пишется в ответ обмена
ONEC_PRICE_TYPE_ID=
