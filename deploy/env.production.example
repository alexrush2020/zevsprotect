# Шаблон deploy/.env.production (скопировать, заполнить, chmod 600; в git не коммитить).
# Файл читают: docker compose (env_file и --env-file), `next build` (BuildKit-секрет, через sh `. файл`).
# Поэтому значения — без кавычек и пробелов, только буквы, цифры и -_.:/@=+%?; пароли: openssl rand -hex 32

# --- домен и TLS (Caddy) ---
SITE_DOMAIN=zevsprotect.ru
ACME_EMAIL=admin@zevsprotect.ru

# --- PostgreSQL (контейнер postgres) ---
POSTGRES_USER=zevs
POSTGRES_DB=zevs
POSTGRES_PASSWORD=
# тот же пароль; хост — имя сервиса postgres
DATABASE_URL=postgres://zevs:ПАРОЛЬ@postgres:5432/zevs

# --- Payload / Next ---
# openssl rand -hex 32; после первого запуска не менять (сессии и токены сбросятся)
PAYLOAD_SECRET=
# вшивается в сборку: после смены — пересобрать образ app
NEXT_PUBLIC_SERVER_URL=https://zevsprotect.ru
# пути томов в контейнере app (compose задаёт их же)
MEDIA_DIR=/data/media
ONEC_EXCHANGE_DIR=/data/1c-exchange

# --- почта (без SMTP_HOST письма только пишутся в лог) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@zevsprotect.ru
# уведомления о заявках; пусто — email из «Настройки → Контакты»
LEADS_EMAIL=

# --- Битрикс24 (пусто — интеграция выключена, отправки падают с ошибкой синхронизации) ---
B24_WEBHOOK_URL=
B24_DEAL_CATEGORY_ID=
B24_DEAL_STAGE_ID=
B24_ASSIGNED_BY_ID=
B24_SOURCE_ID=WEB
B24_REQUISITE_PRESET_ID=
# application_token исходящего вебхука Б24 для /api/b24/webhook; пусто — вебхук отвечает 503
B24_WEBHOOK_TOKEN=
# 1 — сделки и для гостевых заказов (BIZ-7)
B24_GUEST_DEALS=

# --- 1С «Обмен с сайтом» (/api/1c-exchange; логин/пароль пусты — обмен закрыт, 503) ---
ONEC_EXCHANGE_USER=
ONEC_EXCHANGE_PASSWORD=
ONEC_EXCHANGE_FILE_LIMIT=
ONEC_EXCHANGE_XML_LIMIT=
# Ид типа цены для сайта (BIZ-8)
ONEC_PRICE_TYPE_ID=
